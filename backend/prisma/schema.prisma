generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  WAREHOUSE
}

enum CustomerType {
  NATURAL
  BUSINESS
}

enum ProformaStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentMethod {
  CASH
  CARD_POS
  BANK_TRANSFER
  YAPE_PLIN
}

enum InvoiceType {
  BOLETA
  FACTURA
  NOTA_VENTA
}

enum InvoiceStatus {
  PENDING_TRANSMISSION
  ACCEPTED
  REJECTED
  ANULLED
}

// 1. MODELO USER & ACCESOS
model User {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String               @unique @db.VarChar(255)
  passwordHash String               @db.VarChar(255)
  role         Role                 @default(SELLER)
  isActive     Boolean              @default(true)
  
  profileId    String?              @db.Uuid
  profile      Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  resetTokens  PasswordResetToken[]

  proformas    Proforma[]           @relation("SellerProformas")
  statusLogs   ProformaStatusLog[]  @relation("UserStatusLogs")
  sales        Sale[]               @relation("SellerSales")
  
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([profileId])
}

// 2. MODELOS BASE DEL NEGOCIO
model Customer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           CustomerType
  documentNumber String        @unique @db.VarChar(20)
  name           String        @db.VarChar(255)
  email          String?       @db.VarChar(255)
  phone          String?       @db.VarChar(20)
  address        String?       @db.Text
  proformas      Proforma[]
  sales          Sale[]
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([documentNumber])
}

model Product {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalCode String                 @unique @db.VarChar(50)
  name         String                 @db.VarChar(255)
  category     String                 @db.VarChar(100)
  brand        String                 @db.VarChar(100)
  minStock     Int                    @default(5)
  isActive     Boolean                @default(true)
  priceTiers   PriceTier[]
  details      ProformaDetail[]
  stocks       SupplierProductStock[]
  saleDetails  SaleDetail[]
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)

  @@index([internalCode])
  @@index([category])
  @@index([brand])
}

model Supplier {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruc         String                 @unique @db.VarChar(20)
  name        String                 @db.VarChar(255)
  contactName String?                @db.VarChar(150)
  phone       String?                @db.VarChar(20)
  email       String?                @db.VarChar(255)
  isActive    Boolean                @default(true)
  stocks      SupplierProductStock[]
  saleDetails SaleDetail[]
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)

  @@index([ruc])
}

model SupplierProductStock {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String    @db.Uuid
  supplierId  String    @db.Uuid
  supplierSku String?   @db.VarChar(100) // Código de parte del proveedor
  stock       Int       @default(0)
  costPrice   Decimal   @db.Decimal(12, 2)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([productId])
  @@index([supplierId])
}

model PriceTier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  tier      Int
  price     Decimal  @db.Decimal(12, 2)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([productId, tier])
  @@index([productId])
}

model Proforma {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String              @unique @db.VarChar(20)
  customerId  String              @db.Uuid
  sellerId    String              @db.Uuid
  totalAmount Decimal             @db.Decimal(12, 2)
  status      ProformaStatus      @default(DRAFT)
  expiresAt   DateTime            @db.Timestamptz(6)
  customer    Customer            @relation(fields: [customerId], references: [id])
  seller      User                @relation("SellerProformas", fields: [sellerId], references: [id])
  details     ProformaDetail[]
  statusLogs  ProformaStatusLog[]
  sale        Sale?               @relation("ProformaToSale")
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  @@index([code])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
}

model ProformaDetail {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId String   @db.Uuid
  productId  String   @db.Uuid
  supplierId String?   @db.Uuid
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  priceTier  Int
  subtotal   Decimal  @db.Decimal(12, 2)
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([proformaId])
  @@index([productId])
}

model ProformaStatusLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId  String         @db.Uuid
  status      ProformaStatus
  changedById String         @db.Uuid
  reason      String?        @db.Text
  proforma    Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("UserStatusLogs", fields: [changedById], references: [id])
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  @@index([proformaId])
  @@index([changedById])
}

// 3. MODELOS RBAC DINÁMICO Y RECUPERACIÓN DE CONTRASEÑA
model Profile {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String          @unique @db.VarChar(100)
  description String?         @db.Text
  users       User[]
  modules     ProfileModule[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
}

model Module {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(100)
  code      String          @unique @db.VarChar(50)
  path      String          @db.VarChar(255)
  icon      String?         @db.VarChar(50)
  profiles  ProfileModule[]
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
}

model ProfileModule {
  profileId String   @db.Uuid
  moduleId  String   @db.Uuid
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([profileId, moduleId])
  @@index([profileId])
  @@index([moduleId])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique @db.VarChar(255)
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// 4. MODELOS DE VENTAS, COBROS & COMPROBANTES (SPRINT 6)
model Sale {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String       @unique @db.VarChar(30) // Ej: VNT-2026-0001
  proformaId  String?      @unique @db.Uuid
  customerId  String       @db.Uuid
  sellerId    String       @db.Uuid
  subtotal    Decimal      @db.Decimal(12, 2)
  igvAmount   Decimal      @db.Decimal(12, 2) // 18%
  totalAmount Decimal      @db.Decimal(12, 2)
  notes       String?      @db.Text

  proforma    Proforma?    @relation("ProformaToSale", fields: [proformaId], references: [id], onDelete: SetNull)
  customer    Customer     @relation(fields: [customerId], references: [id])
  seller      User         @relation("SellerSales", fields: [sellerId], references: [id])
  details     SaleDetail[]
  payments    Payment[]
  invoice     Invoice?

  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@index([code])
  @@index([customerId])
  @@index([sellerId])
}

model SaleDetail {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId     String   @db.Uuid
  productId  String   @db.Uuid
  supplierId String   @db.Uuid // Proveedor específico del cual se rebaja el stock físico
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  priceTier  Int
  costPrice  Decimal  @db.Decimal(12, 2) // Para auditoría de margen bruto
  subtotal   Decimal  @db.Decimal(12, 2)

  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([supplierId])
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId         String        @db.Uuid
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  receivedAmount Decimal?      @db.Decimal(12, 2) // Monto entregado en efectivo
  changeAmount   Decimal?      @db.Decimal(12, 2) // Vuelto devuelto al cliente
  operationCode  String?       @db.VarChar(50)   // N° Operación bancaria, POS o Yape/Plin
  createdAt      DateTime      @default(now())   @db.Timestamptz(6)

  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model Invoice {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId       String        @unique @db.Uuid
  type         InvoiceType
  series       String        @db.VarChar(10) // B001 o F001
  correlative  Int
  fullCode     String        @unique @db.VarChar(30) // B001-0000001
  status       InvoiceStatus @default(PENDING_TRANSMISSION)
  externalId   String?       @db.VarChar(100) // Ticket ID en Efact/SUNAT
  qrCodeUrl    String?       @db.Text
  cdrHash      String?       @db.VarChar(100)
  errorMessage String?       @db.Text
  issuedAt     DateTime      @default(now()) @db.Timestamptz(6)

  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([fullCode])
  @@index([status])
}