generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  WAREHOUSE
}

enum CustomerType {
  NATURAL
  BUSINESS
}

enum ProformaStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

// 1. MODELO USER ACTUALIZADO
model User {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String               @unique @db.VarChar(255)
  passwordHash String               @db.VarChar(255)
  role         Role                 @default(SELLER)
  isActive     Boolean              @default(true)
  
  profileId    String?              @db.Uuid
  profile      Profile?             @relation(fields: [profileId], references: [id], onDelete: SetNull)
  resetTokens  PasswordResetToken[]

  proformas    Proforma[]           @relation("SellerProformas")
  statusLogs   ProformaStatusLog[]  @relation("UserStatusLogs")
  
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([profileId])
}

// 2. MODELOS BASE DEL NEGOCIO (SE MANTIENEN)
model Customer {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           CustomerType
  documentNumber String        @unique @db.VarChar(20)
  name           String        @db.VarChar(255)
  email          String?       @db.VarChar(255)
  phone          String?       @db.VarChar(20)
  address        String?       @db.Text
  proformas      Proforma[]
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([documentNumber])
}

model Product {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalCode String           @unique @db.VarChar(50)
  name         String           @db.VarChar(255)
  category     String           @db.VarChar(100)
  isActive     Boolean          @default(true)
  priceTiers   PriceTier[]
  details      ProformaDetail[]
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  @@index([internalCode])
}

model PriceTier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  tier      Int
  price     Decimal  @db.Decimal(12, 2)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([productId, tier])
  @@index([productId])
}

model Proforma {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String              @unique @db.VarChar(20)
  customerId  String              @db.Uuid
  sellerId    String              @db.Uuid
  totalAmount Decimal             @db.Decimal(12, 2)
  status      ProformaStatus      @default(DRAFT)
  expiresAt   DateTime            @db.Timestamptz(6)
  customer    Customer            @relation(fields: [customerId], references: [id])
  seller      User                @relation("SellerProformas", fields: [sellerId], references: [id])
  details     ProformaDetail[]
  statusLogs  ProformaStatusLog[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  @@index([code])
  @@index([customerId])
  @@index([sellerId])
  @@index([status])
}

model ProformaDetail {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId String   @db.Uuid
  productId  String   @db.Uuid
  quantity   Int
  unitPrice  Decimal  @db.Decimal(12, 2)
  priceTier  Int
  subtotal   Decimal  @db.Decimal(12, 2)
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([proformaId])
  @@index([productId])
}

model ProformaStatusLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId  String         @db.Uuid
  status      ProformaStatus
  changedById String         @db.Uuid
  reason      String?        @db.Text
  proforma    Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("UserStatusLogs", fields: [changedById], references: [id])
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  @@index([proformaId])
  @@index([changedById])
}

// 3. NUEVOS MODELOS RBAC DINÁMICO Y RECUPERACIÓN DE CONTRASEÑA
model Profile {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String          @unique @db.VarChar(100)
  description String?         @db.Text
  users       User[]
  modules     ProfileModule[]
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
}

model Module {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(100)
  code      String          @unique @db.VarChar(50)
  path      String          @db.VarChar(255)
  icon      String?         @db.VarChar(50)
  profiles  ProfileModule[]
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
}

model ProfileModule {
  profileId String   @db.Uuid
  moduleId  String   @db.Uuid
  canCreate Boolean  @default(false)
  canRead   Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([profileId, moduleId])
  @@index([profileId])
  @@index([moduleId])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String    @unique @db.VarChar(255)
  userId    String    @db.Uuid
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}