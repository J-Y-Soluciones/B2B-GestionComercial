generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SELLER
  WAREHOUSE
}

enum ProformaStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum CustomerType {
  NATURAL
  BUSINESS
}

model User {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String              @unique @db.VarChar(255)
  passwordHash String              @db.VarChar(255)
  role         Role                @default(SELLER)
  isActive     Boolean             @default(true)
  proformas    Proforma[]          @relation("SellerProformas")
  statusLogs   ProformaStatusLog[] @relation("UserStatusLogs")
  createdAt    DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(6)

  @@index([email])
}

model Customer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           CustomerType
  documentNumber String       @unique @db.VarChar(20)
  name           String       @db.VarChar(255)
  email          String?      @db.VarChar(255)
  phone          String?      @db.VarChar(20)
  address        String?      @db.Text
  proformas      Proforma[]
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@index([documentNumber])
}

model Product {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  internalCode    String           @unique @db.VarChar(50)
  name            String           @db.VarChar(255)
  category        String           @db.VarChar(100)
  imageUrl        String?          @db.Text
  isActive        Boolean          @default(true)
  priceTiers      PriceTier[]
  proformaDetails ProformaDetail[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  @@index([internalCode])
}

model PriceTier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  tier      Int      @db.SmallInt
  price     Decimal  @db.Decimal(10, 2)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([productId, tier])
}

model Proforma {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String              @unique @db.VarChar(20)
  customerId  String              @db.Uuid
  sellerId    String              @db.Uuid
  totalAmount Decimal             @db.Decimal(12, 2)
  status      ProformaStatus      @default(PENDING)
  expiresAt   DateTime            @db.Timestamptz(6)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller      User                @relation("SellerProformas", fields: [sellerId], references: [id], onDelete: Restrict)
  details     ProformaDetail[]
  statusLogs  ProformaStatusLog[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)

  @@index([code])
  @@index([customerId])
  @@index([status])
}

model ProformaDetail {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId String   @db.Uuid
  productId  String   @db.Uuid
  quantity   Int      @db.Integer
  unitPrice  Decimal  @db.Decimal(10, 2)
  priceTier  Int      @db.SmallInt
  subtotal   Decimal  @db.Decimal(12, 2)
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([proformaId])
}

model ProformaStatusLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId  String         @db.Uuid
  status      ProformaStatus
  changedById String         @db.Uuid
  reason      String?        @db.Text
  proforma    Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("UserStatusLogs", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  @@index([proformaId])
}